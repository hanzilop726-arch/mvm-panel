<%- include('../partials/head', { title: 'Platform Setup' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="mb-3">
    <div class="pill pill-primary mb-2">PLATFORM CONFIGURATION</div>
    <h2 style="font-size:24px;margin:0">Virtualization &amp; Discord Rewards</h2>
    <p class="muted">Choose available server runtimes and configure optional community VPS rewards.</p>
  </div>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (updated) { %><div class="alert alert-success">Platform settings saved.</div><% } %>

  <form method="post" action="/admin/platform">
    <div class="card mb-3">
      <div class="card-title">Panel interface</div>
      <div class="form-group">
        <label for="panelTheme">Global color theme</label>
        <select id="panelTheme" name="panel.theme">
          <option value="dark" <%= (all['panel.theme'] || 'dark') === 'dark' ? 'selected' : '' %>>Blue + Black</option>
          <option value="default" <%= all['panel.theme'] === 'default' ? 'selected' : '' %>>Slate Indigo</option>
          <option value="neon" <%= all['panel.theme'] === 'neon' ? 'selected' : '' %>>Emerald Neon</option>
          <option value="nord" <%= all['panel.theme'] === 'nord' ? 'selected' : '' %>>Nord Frost</option>
          <option value="dracula" <%= all['panel.theme'] === 'dracula' ? 'selected' : '' %>>Dracula</option>
          <option value="light" <%= all['panel.theme'] === 'light' ? 'selected' : '' %>>Light</option>
        </select>
        <div class="form-hint">Applies to every account. Individual browser theme preferences no longer override this setting.</div>
      </div>
      <div class="form-group">
        <label for="panelUiStyle">Visual style preset</label>
        <select id="panelUiStyle" name="panel.ui_style">
          <option value="convoy" <%= all['panel.ui_style'] !== 'classic' ? 'selected' : '' %>>Convoy-inspired — clean infrastructure dashboard</option>
          <option value="classic" <%= all['panel.ui_style'] === 'classic' ? 'selected' : '' %>>MVM classic — current Arix surface styling</option>
        </select>
        <div class="form-hint">This changes layout surfaces only. Your existing panel name, logo, accent, backgrounds, and theme settings remain customizable.</div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-title">Virtualization backends</div>
      <p class="muted text-sm">KVM stays enabled by default. New LXC containers use LXD; existing containers without a driver marker continue to use classic LXC. Access to the local LXD daemon is effectively host-root access, so grant it only to a trusted panel service.</p>
      <div class="grid grid-2">
        <label class="flex" style="gap:10px;align-items:center">
          <input type="checkbox" name="vm.enable_kvm" value="1" <%= String(all['vm.enable_kvm']) !== '0' ? 'checked' : '' %>/>
          <span><strong>Allow KVM virtual machines</strong><br/><span class="muted text-sm">QEMU/KVM virtual machines</span></span>
        </label>
        <label class="flex" style="gap:10px;align-items:center">
          <input type="checkbox" name="vm.enable_lxc" value="1" <%= String(all['vm.enable_lxc']) === '1' ? 'checked' : '' %>/>
          <span><strong>Allow LXC containers</strong><br/><span class="muted text-sm">Linux containers with CPU, memory, and disk limits</span></span>
        </label>
      </div>
      <div class="grid grid-2 mt-3">
        <div class="form-group">
          <label>Default backend</label>
          <select name="vm.default_virtualization">
            <option value="kvm" <%= all['vm.default_virtualization'] !== 'lxc' ? 'selected' : '' %>>KVM</option>
            <option value="lxc" <%= all['vm.default_virtualization'] === 'lxc' ? 'selected' : '' %>>LXC</option>
          </select>
        </div>
        <div class="form-group">
          <label>Driver for new LXC containers</label>
          <select name="vm.lxc_driver">
            <option value="lxd" <%= lxcDriver === 'lxd' ? 'selected' : '' %>>LXD (recommended; matches the bot workflow)</option>
            <option value="legacy" <%= lxcDriver === 'legacy' ? 'selected' : '' %>>Classic LXC (lxc-create)</option>
          </select>
          <div class="muted text-sm mt-1">Changing this affects new containers only. Existing containers keep their recorded driver.</div>
        </div>
      </div>
      <div class="grid grid-2 mt-3">
        <div class="form-group">
          <label>LXD storage pool name</label>
          <input name="vm.lxd_storage_pool" value="<%= all['vm.lxd_storage_pool'] || 'default' %>" maxlength="63" pattern="[A-Za-z0-9_.-]{1,63}" required/>
          <div class="muted text-sm mt-1">Must match an already-created LXD storage pool.</div>
        </div>
        <div class="form-group">
          <label>Classic LXC network bridge</label>
          <input name="vm.lxc_bridge" value="<%= all['vm.lxc_bridge'] || 'lxcbr0' %>" maxlength="15" required/>
          <div class="muted text-sm mt-1">Used only by legacy classic LXC containers.</div>
        </div>
      </div>
      <div class="muted text-sm">Selected driver readiness: <strong><%= lxcInstalled ? 'ready' : 'not ready' %></strong></div>
      <div class="muted text-sm">LXD: <strong><%= lxdReady ? 'daemon, storage pool, and default profile ready' : 'not ready' %></strong> · Classic LXC tools: <strong><%= legacyLxcInstalled ? 'available' : 'missing' %></strong> · Classic LXC setup: <strong><%= legacyLxcReady ? 'ready' : 'not ready' %></strong></div>
      <% if (lxcDriver === 'lxd' && !lxdReady) { %>
        <div class="alert alert-warning mt-2">Configure and initialize LXD with the selected storage pool and a default profile that provides a root disk and DHCP network. LXC creation stays disabled until LXD is ready.</div>
      <% } %>
      <% if (lxcDriver === 'legacy' && !legacyLxcReady) { %>
        <div class="alert alert-warning mt-2"><%= legacyLxcError %> Classic LXC requires the LXC utilities, CPU and memory cgroup controllers, and a writable container directory. Verify the panel service account's PATH, host cgroups, and container directory permissions.</div>
      <% } %>
    </div>

    <div class="card mb-3">
      <div class="flex-between" style="gap:12px;flex-wrap:wrap">
        <div>
          <div class="card-title">Discord panel control bot</div>
          <p class="muted text-sm">Enable Discord slash commands for VPS list, status, start, stop, and restart. The shared bot stays online if Discord rewards are enabled.</p>
        </div>
        <label class="flex" style="gap:8px;align-items:center">
          <input type="checkbox" name="discord.panel_control_enabled" value="1" <%= String(all['discord.panel_control_enabled']) === '1' ? 'checked' : '' %>/>
          Enable VPS commands
        </label>
      </div>
      <div class="alert alert-info text-sm">
        Discord users must link their account from their panel profile. Users can control only their own VPS; linked panel admins can control all VPSs. Commands cannot create/delete servers or change panel settings.
      </div>
    </div>

    <div class="card mb-3">
      <div class="flex-between" style="gap:12px;flex-wrap:wrap">
        <div>
          <div class="card-title">Discord integration</div>
          <p class="muted text-sm">OAuth links panel accounts. A bot tracks invite joins and checks active server boosts.</p>
        </div>
        <label class="flex" style="gap:8px;align-items:center">
          <input type="checkbox" name="discord.rewards_enabled" value="1" <%= String(all['discord.rewards_enabled']) === '1' ? 'checked' : '' %>/>
          Enable Discord VPS rewards
        </label>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label>Discord Application Client ID</label>
          <input name="discord.client_id" value="<%= all['discord.client_id'] || '' %>" inputmode="numeric"/>
        </div>
        <div class="form-group">
          <label>OAuth callback URL</label>
          <input name="discord.redirect_uri" value="<%= all['discord.redirect_uri'] || defaultRedirectUri %>" placeholder="https://panel.example.com/auth/discord/callback"/>
        </div>
        <div class="form-group">
          <label>Client Secret</label>
          <input name="discord.client_secret" type="password" autocomplete="new-password" placeholder="<%= clientSecretConfigured ? 'Configured — leave blank to keep current secret' : 'Paste the application client secret' %>"/>
          <% if (clientSecretConfigured) { %><label class="flex mt-2" style="gap:8px;align-items:center"><input type="checkbox" name="clear_client_secret" value="1"/> Clear saved client secret</label><% } %>
        </div>
        <div class="form-group">
          <label>Bot Token</label>
          <input name="discord.bot_token" type="password" autocomplete="new-password" placeholder="<%= botTokenConfigured ? 'Configured — leave blank to keep current token' : 'Paste the bot token' %>"/>
          <% if (botTokenConfigured) { %><label class="flex mt-2" style="gap:8px;align-items:center"><input type="checkbox" name="clear_bot_token" value="1"/> Clear saved bot token</label><% } %>
        </div>
        <div class="form-group">
          <label>Discord Server (Guild) ID</label>
          <input name="discord.guild_id" value="<%= all['discord.guild_id'] || '' %>" inputmode="numeric"/>
        </div>
      </div>
      <div class="alert alert-info text-sm">
        Invite verification requires the bot to be in the configured server with <strong>Manage Server</strong> permission and the privileged <strong>Server Members Intent</strong> enabled in the Discord Developer Portal. Add <code><%= defaultRedirectUri %></code> to the OAuth redirect list.
      </div>
    </div>

    <div class="card mb-3">
      <div class="flex-between" style="gap:12px;flex-wrap:wrap">
        <div>
          <div class="card-title">BOLTs earning rules</div>
          <p class="muted text-sm">Configure the currency earned through verified invites and active server boosts.</p>
        </div>
      </div>
      <div class="grid grid-3 mt-3">
        <div class="form-group"><label>Verified invites per payout</label><input type="number" name="discord.invites_per_reward" min="1" max="1000" value="<%= all['discord.invites_per_reward'] || 5 %>" required/></div>
        <div class="form-group"><label>BOLTs per invite payout</label><input type="number" name="discord.invite_reward_bolts" min="1" max="1000000000" value="<%= all['discord.invite_reward_bolts'] || 50 %>" required/></div>
        <div class="form-group"><label>BOLTs per active boost period</label><input type="number" name="discord.boost_reward_bolts" min="1" max="1000000000" value="<%= all['discord.boost_reward_bolts'] || 25 %>" required/></div>
      </div>
      <p class="muted text-sm mb-0">Invite payouts are one-time per set of verified invites. Boost payout is one-time per continuous boost period because Discord does not expose a member's boost count.</p>
    </div>

    <div class="card mb-3">
      <div class="flex-between" style="gap:12px;flex-wrap:wrap">
        <div>
          <div class="card-title">BOLTs VPS shop</div>
          <p class="muted text-sm">Users spend BOLTs to create one of these VPS plans. Set each plan's cost and specifications.</p>
        </div>
        <div class="form-group" style="min-width:220px;margin:0">
          <label>Maximum active BOLTs VPSs per user</label>
          <input type="number" name="discord.reward_max_active" min="1" max="10" value="<%= all['discord.reward_max_active'] || 1 %>" required/>
        </div>
      </div>
      <input type="hidden" name="discord.reward_plans" id="rewardPlansJson" data-initial-plans="<%= JSON.stringify(rewardPlans) %>"/>
      <div id="rewardPlanList" class="mt-3"></div>
      <div class="grid grid-3 mt-3">
        <div class="form-group"><label for="planName">Plan name</label><input id="planName" maxlength="48" placeholder="Community VPS"/></div>
        <div class="form-group"><label for="planCost">Cost (BOLTs)</label><input id="planCost" type="number" min="1" max="1000000000000" value="100" required/></div>
        <div class="form-group"><label for="planCpus">vCPU</label><input id="planCpus" type="number" min="1" max="64" value="1" required/></div>
        <div class="form-group"><label for="planMemory">Memory (MB)</label><input id="planMemory" type="number" min="128" max="65536" step="128" value="1024" required/></div>
        <div class="form-group"><label for="planDisk">Disk</label><input id="planDisk" value="10G" pattern="[1-9][0-9]{0,4}[GMgm]" required/></div>
        <div class="form-group"><label for="planOs">Operating system</label><select id="planOs"><% for (const os of rewardOsList) { %><option value="<%= os[0] %>"><%= os[0] %></option><% } %></select></div>
      </div>
      <button class="btn btn-sm" type="button" id="addRewardPlan"><i data-lucide="plus"></i> Add plan</button>
      <div class="alert alert-info text-sm mt-3 mb-0">Boost earnings are credited once during each continuous boost period. Admins can add BOLTs to any user's account from the user management page.</div>
    </div>
    <button class="btn btn-primary" type="submit">Save platform settings</button>
  </form>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
(() => {
  const jsonInput = document.getElementById('rewardPlansJson');
  const plans = JSON.parse(jsonInput.dataset.initialPlans || '[]');
  const list = document.getElementById('rewardPlanList');
  const renderPlans = () => {
    list.replaceChildren();
    plans.forEach((plan, index) => {
      const row = document.createElement('div');
      row.className = 'flex-between';
      row.style.cssText = 'gap:12px;padding:12px 0;border-bottom:1px solid var(--border);flex-wrap:wrap';
      const details = document.createElement('div');
      details.textContent = `${plan.name} · ${plan.costBolts} BOLTs · ${plan.cpus} vCPU · ${plan.memory} MB · ${plan.disk} · ${plan.os}`;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn btn-sm btn-danger';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => { plans.splice(index, 1); renderPlans(); });
      row.append(details, remove);
      list.append(row);
    });
    jsonInput.value = JSON.stringify(plans);
  };
  document.getElementById('addRewardPlan').addEventListener('click', () => {
    const name = document.getElementById('planName').value.trim();
    const formFields = ['planName', 'planCost', 'planCpus', 'planMemory', 'planDisk', 'planOs'];
    if (!name || !formFields.every((id) => document.getElementById(id).reportValidity())) return;
    plans.push({
      id: crypto.randomUUID ? crypto.randomUUID() : `plan-${Date.now()}-${Math.random().toString(16).slice(2)}`,
      name, costBolts: Number(document.getElementById('planCost').value),
      cpus: Number(document.getElementById('planCpus').value),
      memory: Number(document.getElementById('planMemory').value),
      disk: document.getElementById('planDisk').value.trim().toUpperCase(),
      os: document.getElementById('planOs').value,
    });
    document.getElementById('planName').value = '';
    renderPlans();
  });
  document.querySelector('form[action="/admin/platform"]').addEventListener('submit', (event) => {
    renderPlans();
    if (!plans.length && document.querySelector('[name="discord.rewards_enabled"]').checked) {
      event.preventDefault();
      alert('Add at least one reward plan before enabling rewards.');
    }
  });
  renderPlans();
})();
</script>
