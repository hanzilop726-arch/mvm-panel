<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<main class="vertex-dashboard">
  <section class="vertex-page-heading">
    <div>
      <h1>Cloud Instances &amp; VPS</h1>
      <p>Manage, monitor, and access your cloud servers.</p>
    </div>
    <% if (user && (user.role === 'admin' || user.root_admin)) { %>
      <a class="btn btn-primary vertex-mobile-deploy" href="/admin/servers/create"><i data-lucide="rocket"></i> Deploy VPS</a>
    <% } %>
  </section>

  <section class="vertex-panel vertex-services" id="services">
    <header class="vertex-panel-heading">
      <h2>Active Services</h2>
      <span class="vertex-count"><%= vms.length %></span>
      <label class="vertex-search">
        <i data-lucide="search"></i>
        <input type="search" id="vmSearch" placeholder="Search services" aria-label="Search services"/>
      </label>
    </header>
    <% if (vms.length === 0) { %>
      <div class="vertex-empty">
        <i data-lucide="server-off"></i>
        <strong>No services yet</strong>
        <span>Your cloud instances will appear here once they are deployed.</span>
        <% if (user && (user.role === 'admin' || user.root_admin)) { %>
          <a class="btn btn-primary" href="/admin/servers/create"><i data-lucide="plus"></i> Deploy your first VPS</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-wrap vertex-table-wrap">
        <table class="vertex-table">
          <thead>
            <tr><th>Service name</th><th>Location</th><th>SSH endpoint</th><th>OS</th><th>Resources</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
          <% for (const v of vms) { %>
            <tr class="vertex-service-row" data-search="<%= `${v.name} ${v.hostname || ''} ${v.os_type || ''} ${v.virtualization || ''} ${v.ssh_port || ''}` %>">
              <td>
                <a class="vertex-service-name" href="/servers/<%= v.id %>"><%= v.name %></a>
                <span class="vertex-service-type"><%= v.virtualization === 'lxc' ? 'LXC container' : 'Cloud VPS' %></span>
              </td>
              <td><span class="vertex-location"><span></span> <%= v.location || 'Default node' %></span></td>
              <td class="mono vertex-ssh">Port <%= v.ssh_port %></td>
              <td><%= v.os_type || 'Linux' %></td>
              <td><%= v.cpus %> vCPU · <%= v.memory >= 1024 ? (v.memory / 1024).toFixed(v.memory % 1024 ? 1 : 0) + ' GB' : v.memory + ' MB' %> · <%= v.disk_size || '20G' %></td>
              <td><span class="vertex-status <%= v.status === 'running' ? 'is-online' : 'is-offline' %>"><%= v.status === 'running' ? 'ACTIVE' : 'STOPPED' %></span></td>
              <td class="vertex-actions">
                <a class="vertex-manage" href="/servers/<%= v.id %>">Manage <i data-lucide="arrow-up-right"></i></a>
                <a class="vertex-icon-action" href="/servers/<%= v.id %>/console" title="Open terminal" aria-label="Open terminal"><i data-lucide="terminal"></i></a>
                <button class="vertex-icon-action" onclick="power(<%= v.id %>, '<%= v.status === 'running' ? 'stop' : 'start' %>')" title="<%= v.status === 'running' ? 'Stop' : 'Start' %> server" aria-label="<%= v.status === 'running' ? 'Stop' : 'Start' %> server"><i data-lucide="<%= v.status === 'running' ? 'square' : 'play' %>"></i></button>
                <% if (v.status === 'running') { %><button class="vertex-icon-action" onclick="power(<%= v.id %>, 'restart')" title="Restart server" aria-label="Restart server"><i data-lucide="rotate-cw"></i></button><% } %>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
      <div class="vertex-mobile-services">
        <% for (const v of vms) { %>
          <article class="vertex-mobile-service" data-search="<%= `${v.name} ${v.hostname || ''} ${v.os_type || ''} ${v.virtualization || ''} ${v.ssh_port || ''}` %>">
            <div class="vertex-mobile-service-heading">
              <div><a class="vertex-service-name" href="/servers/<%= v.id %>"><%= v.name %></a><span class="vertex-service-type"><%= v.virtualization === 'lxc' ? 'LXC container' : 'Cloud VPS' %></span></div>
              <span class="vertex-status <%= v.status === 'running' ? 'is-online' : 'is-offline' %>"><%= v.status === 'running' ? 'ACTIVE' : 'STOPPED' %></span>
            </div>
            <div class="vertex-mobile-specs"><span><%= v.os_type || 'Linux' %></span><span><%= v.cpus %> vCPU</span><span><%= v.memory >= 1024 ? (v.memory / 1024).toFixed(v.memory % 1024 ? 1 : 0) + ' GB RAM' : v.memory + ' MB RAM' %></span><span>SSH :<%= v.ssh_port %></span></div>
            <div class="vertex-actions">
              <a class="vertex-manage" href="/servers/<%= v.id %>">Manage service <i data-lucide="arrow-up-right"></i></a>
              <button class="vertex-icon-action" onclick="power(<%= v.id %>, '<%= v.status === 'running' ? 'stop' : 'start' %>')" title="<%= v.status === 'running' ? 'Stop' : 'Start' %> server" aria-label="<%= v.status === 'running' ? 'Stop' : 'Start' %> server"><i data-lucide="<%= v.status === 'running' ? 'square' : 'play' %>"></i></button>
            </div>
          </article>
        <% } %>
      </div>
      <div class="vertex-no-results" id="vmNoResults" hidden>No services match your search.</div>
    <% } %>
  </section>

  <% if (subVms && subVms.length > 0) { %>
    <section class="vertex-panel vertex-shared">
      <header class="vertex-panel-heading"><h2>Shared with you</h2><span class="vertex-count"><%= subVms.length %></span></header>
      <div class="table-wrap vertex-table-wrap">
        <table class="vertex-table">
          <thead><tr><th>Service name</th><th>Owner</th><th>Status</th><th>Manage</th></tr></thead>
          <tbody><% for (const v of subVms) { %>
            <tr><td><a class="vertex-service-name" href="/servers/<%= v.id %>"><%= v.name %></a></td><td><%= v.owner_name || 'Team member' %></td><td><span class="vertex-status <%= v.status === 'running' ? 'is-online' : 'is-offline' %>"><%= v.status === 'running' ? 'ACTIVE' : 'STOPPED' %></span></td><td><a class="vertex-manage" href="/servers/<%= v.id %>">Open <i data-lucide="arrow-up-right"></i></a></td></tr>
          <% } %></tbody>
        </table>
      </div>
    </section>
  <% } %>

  <section class="vertex-quick-links" aria-label="Quick links">
    <a class="vertex-quick-card vertex-support-card" href="/activity">
      <span class="vertex-quick-icon"><i data-lucide="messages-square"></i></span>
      <span class="vertex-quick-live"><span></span> Activity</span>
      <strong>Activity &amp; Updates</strong>
      <span class="vertex-quick-description">Review your recent account and server activity.</span>
      <span class="vertex-quick-action">View activity <i data-lucide="arrow-right"></i></span>
    </a>
    <a class="vertex-quick-card" href="/dashboard#services">
      <span class="vertex-quick-icon"><i data-lucide="cpu"></i></span>
      <strong>Cloud Server</strong>
      <span class="vertex-quick-description">View and manage your virtual servers and containers.</span>
      <span class="vertex-quick-action">Browse services <i data-lucide="arrow-right"></i></span>
    </a>
    <a class="vertex-quick-card" href="/rewards">
      <span class="vertex-quick-icon vertex-green-icon"><i data-lucide="database"></i></span>
      <strong>Earn BOLTs</strong>
      <span class="vertex-quick-description"><%= Number(boltBalance) || 0 %> BOLTs in your wallet. Earn through verified invites or Discord boosts.</span>
      <span class="vertex-quick-action vertex-green-text">View rewards <i data-lucide="arrow-right"></i></span>
    </a>
    <a class="vertex-quick-card" href="/settings">
      <span class="vertex-quick-icon"><i data-lucide="settings-2"></i></span>
      <strong>Account Settings</strong>
      <span class="vertex-quick-description">Update your account preferences and security options.</span>
      <span class="vertex-quick-action">Open settings <i data-lucide="arrow-right"></i></span>
    </a>
  </section>

  <% if (recentActivity && recentActivity.length > 0) { %>
    <details class="vertex-activity">
      <summary>Recent activity <span><%= recentActivity.length %></span></summary>
      <div class="table-wrap vertex-table-wrap">
        <table class="vertex-table"><thead><tr><th>Event</th><th>Details</th><th>Time</th></tr></thead><tbody>
          <% for (const item of recentActivity.slice(0, 8)) { %>
            <tr><td><%= item.event %></td><td><%= item.details ? JSON.stringify(item.details) : '—' %></td><td><%= new Date(item.created_at).toLocaleString() %></td></tr>
          <% } %>
        </tbody></table>
      </div>
    </details>
  <% } %>
  <footer class="vertex-footer">© 2020–<%= new Date().getFullYear() %> <%= settings['panel.name'] || 'MVM Panel' %></footer>
</main>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
document.getElementById('vmSearch')?.addEventListener('input', function() {
  const query = this.value.toLowerCase().trim();
  let visible = 0;
  document.querySelectorAll('.vertex-service-row, .vertex-mobile-service').forEach((row) => {
    const matches = (row.dataset.search || row.textContent).toLowerCase().includes(query);
    row.hidden = !matches;
    if (row.classList.contains('vertex-service-row') && matches) visible++;
  });
  const noResults = document.getElementById('vmNoResults');
  if (noResults) noResults.hidden = visible > 0;
});

async function power(id, action) {
  try {
    const response = await fetch(`/servers/${id}/power`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action }),
    });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(result.error || 'Power action failed');
    if (window.VP?.toast) VP.toast(`Server ${action} successful`, 'success');
    setTimeout(() => location.reload(), 600);
  } catch (error) {
    if (window.VP?.toast) VP.toast(error.message, 'error');
    else window.alert(error.message);
  }
}
</script>
