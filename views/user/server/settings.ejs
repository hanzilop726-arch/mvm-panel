<%- include('../../partials/head', { title: vm.name + ' - Settings' }) %>
<%- include('../../partials/ambient') %>
<%- include('../../partials/topbar') %>
<%- include('../../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <h2 style="font-size:22px">Settings · <%= vm.name %></h2>
    <a class="btn btn-sm" href="/servers/<%= vm.id %>">Back</a>
  </div>
  <%- include('_tabs') %>

  <div class="card">
    <div class="card-title">Server Settings</div>
    <div class="alert alert-info">Changing the hostname / username / password regenerates the cloud-init seed. It takes effect after the server is restarted and re-provisioned.</div>
    <div class="alert alert-info">CPU, memory, and disk allocations are managed by an administrator. Contact support if your plan needs an upgrade.</div>
    <div class="form-row">
      <div class="form-group"><label>Server Name</label><input id="fName" value="<%= vm.name %>"/></div>
      <div class="form-group"><label>Hostname</label><input id="fHost" value="<%= vm.hostname %>"/></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>SSH Username</label><input id="fUser" value="<%= vm.username %>"/></div>
      <div class="form-group"><label>SSH Password</label><input id="fPass" type="text" value="<%= vm.password %>"/></div>
    </div>
    <div class="form-row-3">
      <div class="form-group"><label>Memory</label><input value="<%= vm.memory %> MB" readonly/></div>
      <div class="form-group"><label>CPUs</label><input value="<%= vm.cpus %>" readonly/></div>
      <div class="form-group"><label>GUI Mode</label>
        <select id="fGui">
          <option value="0" <%= vm.gui_mode ? '' : 'selected' %>>Console (headless)</option>
          <option value="1" <%= vm.gui_mode ? 'selected' : '' %>>GUI (display)</option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label>Port Forwards (comma separated host:guest)</label>
      <input id="fFwds" value="<%= (vm.port_forwards || []).map(f => f.host + ':' + f.guest).join(',') %>"/>
      <div class="form-hint">e.g. 8080:80, 8443:443 — forwards host port to the VM port</div>
    </div>
    <button class="btn btn-primary" onclick="saveSettings()">Save Settings</button>
  </div>

  <div class="card mt-3">
    <div class="card-title">Disk Allocation</div>
    <div class="form-group"><label>Assigned disk</label><input value="<%= vm.disk_size %>" readonly/></div>
  </div>
</div>
<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>
<script>
function val(id) { return document.getElementById(id).value; }
async function saveSettings() {
  const body = {
    name: val('fName'), hostname: val('fHost'), username: val('fUser'), password: val('fPass'),
    gui_mode: val('fGui') === '1',
    port_forwards: val('fFwds').split(',').map(s => s.trim()).filter(Boolean).map(p => { const [h, g] = p.split(':'); return { host: parseInt(h,10), guest: parseInt(g,10) }; }),
  };
  try {
    await VP.api('/servers/<%= vm.id %>/settings', { method: 'POST', body });
    VP.toast('Settings saved', 'success');
    setTimeout(() => location.reload(), 800);
  } catch (e) { VP.toast(e.message, 'error'); }
}
</script>
