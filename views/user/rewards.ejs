<%- include('../partials/head', { title: 'Discord Rewards' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3" style="gap:16px;flex-wrap:wrap">
    <div>
      <div class="pill pill-primary mb-2">COMMUNITY REWARDS</div>
      <h2 style="font-size:24px;margin:0">Discord VPS Rewards</h2>
      <p class="muted mb-0">Connect Discord and meet the requirements for one of the VPS plans below.</p>
    </div>
    <a class="btn" href="/dashboard">Back to dashboard</a>
  </div>

  <% if (connected) { %><div class="alert alert-success">Discord account connected successfully.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (rewardStatus.error) { %><div class="alert alert-error"><%= rewardStatus.error %></div><% } %>

  <% if (!rewardStatus.enabled) { %>
    <div class="card">
      <div class="card-title">Rewards are unavailable</div>
      <p class="muted mb-0">The administrator has disabled Discord VPS rewards.</p>
    </div>
  <% } else { %>
    <div class="grid grid-2" style="align-items:start">
      <div class="card">
        <div class="card-title">Your Discord account</div>
        <% if (!rewardStatus.configured) { %>
          <div class="alert alert-info">The administrator still needs to finish the Discord integration setup.</div>
        <% } else if (rewardStatus.linked) { %>
          <div class="flex-between" style="gap:12px">
            <div>
              <div style="font-weight:700"><%= rewardStatus.discordUsername || 'Connected account' %></div>
              <div class="muted text-sm">Discord account connected</div>
            </div>
            <span class="pill pill-green">Connected</span>
          </div>
        <% } else { %>
          <p class="muted">Link your Discord account to verify your invites or server boost.</p>
          <a class="btn btn-primary" href="/auth/discord/start">Connect Discord</a>
        <% } %>
      </div>

      <div class="card">
        <div class="card-title">Reward progress</div>
        <div class="grid grid-2 mb-3">
          <div class="stat">
            <div><div class="stat-value"><%= rewardStatus.invites %></div><div class="stat-label">Verified invites</div></div>
          </div>
          <div class="stat">
            <div><div class="stat-value"><%= rewardStatus.boosting ? 'Active' : 'Not active' %></div><div class="stat-label">Server boost</div></div>
          </div>
        </div>
        <div class="flex-between" style="gap:12px;flex-wrap:wrap">
          <strong><span id="rewardBoltBalance"><%= rewardStatus.boltBalance %></span> BOLTs</strong>
          <span class="muted text-sm">Wallet balance</span>
        </div>
        <p class="muted text-sm mt-2 mb-0"><%= rewardStatus.invites %  rewardStatus.invitesPerReward %> / <%= rewardStatus.invitesPerReward %> invites toward +<%= rewardStatus.inviteRewardBolts %> BOLTs</p>
        <p class="muted text-sm mt-1 mb-0"><%= rewardStatus.boosting ? `Boost active: +${rewardStatus.boostRewardBolts} BOLTs awarded for this boost period.` : `Start boosting to earn ${rewardStatus.boostRewardBolts} BOLTs.` %></p>
        <div class="alert alert-success mt-3" id="claimResult" style="display:none">
          <strong id="rewardVmName"></strong> is ready.
          <div class="mt-2">SSH username: <code>root</code></div>
          <div>Password: <code id="rewardVmPassword"></code></div>
          <a id="rewardVmLink" class="btn btn-sm mt-2">Open VPS</a>
          <p class="muted text-sm mt-2 mb-0">Save this password now. The panel will not show it again on this page.</p>
        </div>
        <p class="muted text-sm mt-2"><%= rewardStatus.reason %></p>
        <div class="muted text-sm">BOLTs VPSs: <%= rewardStatus.activeCount %> / <%= rewardStatus.maxActive %></div>
      </div>
    </div>

    <section class="mt-3">
      <div class="flex-between mb-2"><h3 style="font-size:18px;margin:0">Available VPS plans</h3></div>
      <div class="grid grid-2">
        <% for (const plan of rewardStatus.plans) { %>
          <article class="card">
            <div class="flex-between" style="gap:12px">
              <div class="card-title" style="margin:0"><%= plan.name %></div>
              <span class="pill <%= plan.affordable ? 'pill-green' : 'pill-gray' %>"><%= plan.affordable ? 'Available' : 'Not enough BOLTs' %></span>
            </div>
            <p class="muted text-sm mt-2"><strong><%= plan.costBolts %> BOLTs</strong> required</p>
            <div class="grid grid-3 text-sm">
              <div><span class="muted">CPU</span><br/><strong><%= plan.cpus %> vCPU</strong></div>
              <div><span class="muted">Memory</span><br/><strong><%= plan.memory %> MB</strong></div>
              <div><span class="muted">Disk</span><br/><strong><%= plan.disk %></strong></div>
              <div><span class="muted">OS</span><br/><strong><%= plan.os %></strong></div>
            </div>
            <% if (plan.affordable && rewardStatus.activeCount < rewardStatus.maxActive) { %>
              <button type="button" class="btn btn-primary mt-3" onclick="claimReward('<%= plan.id %>')">Buy VPS · <%= plan.costBolts %> BOLTs</button>
            <% } else if (rewardStatus.activeCount < rewardStatus.maxActive) { %>
              <p class="muted text-sm mt-3">Earn <%= Math.max(0, plan.costBolts - rewardStatus.boltBalance) %> more BOLTs to buy this plan.</p>
            <% } %>
          </article>
        <% } %>
      </div>
    </section>
  <% } %>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
async function claimReward(planId) {
  const button = Array.from(document.querySelectorAll('button[onclick^="claimReward("]')).find((item) => item.getAttribute('onclick') === `claimReward('${planId}')`);
  if (!button) return;
  button.disabled = true;
  button.textContent = 'Provisioning...';
  try {
    const response = await fetch('/rewards/vps', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ planId }),
    });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(result.error || 'Could not create the reward VPS');
    document.getElementById('rewardVmName').textContent = result.vm.name;
    document.getElementById('rewardVmPassword').textContent = result.credentials.password;
    document.getElementById('rewardBoltBalance').textContent = result.boltBalance;
    const link = document.getElementById('rewardVmLink');
    link.href = result.redirect;
    document.getElementById('claimResult').style.display = '';
    button.textContent = 'Purchased';
  } catch (error) {
    button.disabled = false;
    button.textContent = 'Claim this VPS';
    if (window.VP?.toast) VP.toast(error.message, 'error');
    else alert(error.message);
  }
}
</script>
